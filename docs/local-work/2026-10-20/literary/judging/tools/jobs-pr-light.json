   },
   {
    "eshot": "pr-ps1-light-simple-a",
    "esel": ".app"
   },
   {
    "etext": "pr-ps1-light-simple-a",
    "tsel": "#p-ps1"
   },
   {
    "eval": "(()=>{const r=document.querySelector('#p-ps1');return r? [...r.querySelectorAll('a,button')].filter(a=>a.getClientRects().length).map(a=>(a.innerText||a.getAttribute('aria-label')||'').replace(/\\s+/g,' ').trim().slice(0,70)+' => '+(a.getAttribute('href')||Object.keys(a.dataset).join(','))):null})()"
   },
   {
    "clickText": {
     "sel": "#p-ps1 [data-src]",
     "text": ""
    }
   },
   {
    "scrollTo": {
     "sel": "#p-ps1 .fx-src"
    }
   },
   {
    "eshot": "pr-ps1-light-simple-src",
    "esel": ".app"
   },
   {
    "etext": "pr-ps1-light-simple-src",
    "tsel": "#p-ps1"
   }
  ]
 },
